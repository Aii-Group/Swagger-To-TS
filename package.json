{
  "name": "swagger-to-ts-axios",
  "version": "2.2.0",
  "description": "Generate TypeScript interfaces from Swagger/OpenAPI and create type-safe axios wrappers",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "bin": {
    "swagger-to-ts": "dist/cjs/cli.js"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "clean": "rimraf dist",
    "commit": "git-cz",
    "prepare": "husky install",
    "lint:commit": "commitlint --from HEAD~1 --to HEAD --verbose"
  },
  "keywords": [
    "swagger",
    "openapi",
    "typescript",
    "axios",
    "codegen",
    "api",
    "type-safe"
  ],
  "author": "AII Group",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.6",
    "jiti": "^2.4.2",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.30",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
